---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import WorkCard from '../components/WorkCard.astro';
import { src } from '../lib/base';
import { sortCategories } from '../content.config';

const works = (await getCollection('works')).sort(
  (a, b) => a.data.order - b.data.order || b.data.date.valueOf() - a.data.date.valueOf(),
);

// 自动分类：完全由 frontmatter 的 category 聚合而来，无需手动维护
const categories = sortCategories([...new Set(works.map((w) => w.data.category))]);
const counts = Object.fromEntries(
  categories.map((c) => [c, works.filter((w) => w.data.category === c).length]),
);

const featured = works.find((w) => w.data.order <= 1) ?? works[0];
const rest = works.filter((w) => w.id !== featured?.id);

const total = works.length;
---

<Base title="作品集 · 网络与新媒体">
  <Nav />

  <main id="main">
    <!-- 首屏 -->
    <section class="hero">
      <div class="wrap hero__inner">
        <p class="hero__eyebrow reveal" data-delay="0">
          新媒体交互设计 · 课程作业
        </p>
        <h1 class="hero__title reveal" data-delay="60">
          把想法做成<br />
          <em>可以被打开的作品</em>
        </h1>
        <p class="hero__lead reveal" data-delay="120">
          这里收录我的交互作品、影像作品与学术论文。每一件都附有创作说明、原文件与可交互预览，
          按分类自动归集。
        </p>
        <div class="hero__actions reveal" data-delay="180">
          <a class="btn btn--primary magnetic" href={src('works/')}>
            浏览全部作品
          </a>
          <a class="btn btn--ghost magnetic" href={src('about/')}>关于我</a>
        </div>

        <dl class="hero__stats reveal" data-delay="240">
          {
            categories.map((c) => (
              <div class="hero__stat">
                <dt>{c}</dt>
                <dd>{counts[c]}</dd>
              </div>
            ))
          }
          <div class="hero__stat">
            <dt>合计</dt>
            <dd>{total}</dd>
          </div>
        </dl>
      </div>
    </section>

    <!-- 作品墙 -->
    <section class="works" id="works">
      <div class="wrap">
        <header class="section-head reveal">
          <h2 class="section-title">作品</h2>
          <p class="section-sub">
            共 {total} 件 · 点击分类可筛选
          </p>
        </header>

        <!--
          筛选：分类由 frontmatter 自动聚合，按钮 data-cat 属性驱动，
          由脚本切换显示。之所以用脚本而非 :has()，
          是因为卡片组件属于独立作用域，纯 CSS 选择器无法稳定命中。
        -->
        <div class="filters reveal" data-delay="60" role="group" aria-label="按分类筛选">
          <button class="filters__pill is-active" data-filter="全部" type="button">
            全部 <span>{total}</span>
          </button>
          {
            categories.map((c) => (
              <button class="filters__pill" data-filter={c} type="button">
                {c} <span>{counts[c]}</span>
              </button>
            ))
          }
        </div>

        <div class="work-grid" data-work-grid>
          {
            featured && (
              <div class="work-grid__featured" data-cell>
                <WorkCard work={featured} delay={0} featured />
              </div>
            )
          }
          {
            rest.map((w, i) => (
              <div class="work-grid__cell" data-cell>
                <WorkCard work={w} delay={(i % 3) * 80} />
              </div>
            ))
          }
        </div>

        <p class="empty-note" data-empty-note hidden>当前分类下暂无作品。</p>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__inner">
      <p>作品集 · Assignment2</p>
      <p class="footer__muted">
        由 Astro 构建 · 图片托管于 GitHub Pages · <a href="https://github.com/hualala25" target="_blank" rel="noreferrer">GitHub</a>
      </p>
    </div>
  </footer>

  <script>
    // 分类筛选：分类列表由 frontmatter 自动聚合，按钮 data-filter 与卡片 data-cat 对应
    const pills = document.querySelectorAll<HTMLButtonElement>('.filters__pill');
    const cells = document.querySelectorAll<HTMLElement>('[data-cell]');
    const emptyNote = document.querySelector<HTMLElement>('[data-empty-note]');

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        const target = pill.dataset.filter ?? '全部';

        pills.forEach((p) => {
          const on = p === pill;
          p.classList.toggle('is-active', on);
          p.setAttribute('aria-pressed', String(on));
        });

        let visible = 0;
        cells.forEach((cell) => {
          const work = cell.querySelector<HTMLElement>('.work');
          const cat = work?.dataset.cat;
          const match = target === '全部' || cat === target;
          cell.hidden = !match;

          if (!match) return;
          visible++;

          // 精选卡片被隐藏时需要收起跨列占位，否则网格会留下空洞
          if (cell.classList.contains('work-grid__featured')) {
            cell.style.gridColumn = match ? 'span 2' : 'auto';
            cell.style.gridRow = match ? 'span 2' : 'auto';
          }

          work?.classList.remove('is-visible');
          requestAnimationFrame(() => work?.classList.add('is-visible'));
        });

        if (emptyNote) emptyNote.hidden = visible > 0;
      });
    });
  </script>
</Base>

<style>
  /* ---------- 首屏 ---------- */
  .hero {
    position: relative;
    padding: 96px 0 76px;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    max-width: 780px;
  }

  .hero__eyebrow {
    font-size: 13px;
    letter-spacing: 0.16em;
    color: var(--primary);
    font-weight: 500;
    margin-bottom: 22px;
  }

  .hero__title {
    font-family: var(--font-serif);
    font-size: clamp(36px, 6.4vw, 62px);
    line-height: 1.24;
    letter-spacing: -0.015em;
  }

  .hero__title em {
    font-style: normal;
    color: var(--primary);
    position: relative;
  }

  .hero__title em::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    height: 8px;
    background: var(--primary-soft);
    opacity: 0.5;
    border-radius: 3px;
    z-index: -1;
  }

  .hero__lead {
    margin-top: 26px;
    max-width: 560px;
    font-size: 16px;
    line-height: 1.85;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 34px;
    margin: 52px 0 0;
    padding-top: 30px;
    border-top: 1px solid var(--line);
  }

  .hero__stat dt {
    font-size: 12.5px;
    color: var(--ink-faint);
    margin-bottom: 4px;
  }

  .hero__stat dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 26px;
    color: var(--primary-deep);
    line-height: 1;
  }

  /* ---------- 作品区 ---------- */
  .works {
    padding: 40px 0 100px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 26px;
  }

  .section-title {
    font-family: var(--font-serif);
    font-size: 28px;
  }

  .section-sub {
    font-size: 13.5px;
    color: var(--ink-faint);
  }

  /* 筛选 pills */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
  }

  .filters__pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--bg-elevated);
    color: var(--ink-soft);
    font-size: 13.5px;
    font-family: inherit;
    cursor: pointer;
    user-select: none;
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      color 0.3s ease,
      transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
      box-shadow 0.3s ease;
  }

  .filters__pill span {
    font-size: 11.5px;
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-faint);
    transition: background-color 0.3s ease, color 0.3s ease;
  }

  .filters__pill:hover {
    border-color: var(--primary-soft);
    color: var(--primary-deep);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
  }

  .filters__pill.is-active {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
    box-shadow: var(--shadow-md);
  }

  .filters__pill.is-active span {
    background: rgba(255, 255, 255, 0.24);
    color: #fff;
  }

  /* 网格 */
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
    align-items: start;
  }

  /* 精选作品占两列，与其余卡片处于同一网格流 */
  .work-grid__featured {
    grid-column: span 2;
    grid-row: span 2;
  }

  .work-grid__cell {
    display: flex;
  }

  .work-grid__cell > :global(.work) {
    width: 100%;
  }

  @media (max-width: 720px) {
    .work-grid__featured {
      grid-column: span 1;
      grid-row: auto;
    }
  }

  /* 注：筛选的显示/隐藏由脚本控制（data-cell / data-cat 属性），
     .work 卡片属于组件独立作用域，纯 CSS 选择器无法稳定命中。 */

  .empty-note {
    text-align: center;
    color: var(--ink-faint);
    font-size: 14px;
    padding: 40px 0;
  }

  /* ---------- 页脚 ---------- */
  .footer {
    border-top: 1px solid var(--line);
    padding: 30px 0;
    background: var(--bg-elevated);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    justify-content: space-between;
    font-size: 13px;
    color: var(--ink-soft);
  }

  .footer__muted {
    color: var(--ink-faint);
  }

  .footer a:hover {
    color: var(--primary-deep);
  }
</style>
