---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { src } from '../lib/base';
---

<Base title="页面不存在 · 作品集">
  <Nav />

  <main id="main" class="page">
    <div class="wrap err">
      <p class="err__code reveal">404</p>
      <h1 class="err__title reveal" data-delay="60">这里没有作品</h1>
      <p class="err__text reveal" data-delay="120">
        页面可能已被移动或删除。回到作品列表看看别的？
      </p>
      <div class="err__actions reveal" data-delay="180">
        <a class="btn btn--primary magnetic" href={src('works/')}>浏览全部作品</a>
        <a class="btn btn--ghost magnetic" href={src('')}>回到首页</a>
      </div>
    </div>
  </main>
</Base>

<style>
  .page {
    padding: 110px 0 130px;
  }

  .err {
    text-align: center;
    max-width: 520px;
  }

  .err__code {
    font-family: var(--font-serif);
    font-size: 76px;
    color: var(--primary-soft);
    line-height: 1;
    letter-spacing: 0.04em;
  }

  .err__title {
    font-family: var(--font-serif);
    font-size: 27px;
    margin-top: 12px;
  }

  .err__text {
    margin-top: 14px;
    color: var(--ink-soft);
    font-size: 15px;
  }

  .err__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-top: 30px;
  }
</style>
