---
import { src } from '../lib/base';
import type { CollectionEntry } from 'astro:content';

interface Props {
  work: CollectionEntry<'works'>;
  delay?: number;
  featured?: boolean;
}

const { work, delay = 0, featured = false } = Astro.props;
const d = work.data;
const href = src(`works/${work.id}/`);
const isPaper = d.type === 'paper';
---

<article
  class={`work card reveal ${featured ? 'work--featured' : ''}`}
  data-delay={delay}
  data-cat={d.category}
  data-type={d.type}
>
  <!-- 封面 / 预览区 -->
  <div class="work__media">
    {
      d.cover ? (
        <img
          class="work__cover"
          src={d.cover}
          alt={`${d.title} 封面`}
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="work__placeholder" aria-hidden="true">
          <span>{isPaper ? '论文' : d.category.slice(0, 2)}</span>
        </div>
      )
    }
    {d.embed && d.preview && (
      <div class="work__embed">
        <iframe
          src={d.preview}
          title={`${d.title} 在线预览`}
          loading="lazy"
          allowfullscreen
        />
      </div>
    )}
    <span class="work__badge">{d.category}</span>
  </div>

  <!-- 信息区 -->
  <div class="work__body">
    <div class="work__meta">
      <span class="work__date">
        {d.year ?? d.date.getFullYear()}
      </span>
      {isPaper && d.venue && <span class="work__venue">{d.venue}</span>}
    </div>

    <h3 class="work__title">
      <a href={href}>{d.title}</a>
    </h3>

    <p class="work__summary">{d.summary}</p>

    {
      d.tags.length > 0 && (
        <ul class="work__tags">
          {d.tags.slice(0, 4).map((t) => (
            <li>
              <span class="tag">{t}</span>
            </li>
          ))}
        </ul>
      )
    }

    <div class="work__actions">
      <a class="work__link" href={href}>
        查看详情 <span aria-hidden="true">→</span>
      </a>
      {d.download && (
        <a class="work__link work__link--muted" href={src(`downloads/${d.download}`)} download>
          下载原文件
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .work {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transform-style: preserve-3d;
  }

  /* 封面区 */
  .work__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  .work__cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .work:hover .work__cover {
    transform: scale(1.045);
  }

  .work__placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(140deg, var(--surface), var(--surface-strong));
  }

  .work__placeholder span {
    font-family: var(--font-serif);
    font-size: 34px;
    color: var(--primary);
    opacity: 0.42;
    letter-spacing: 0.1em;
  }

  .work__embed {
    position: absolute;
    inset: 0;
    background: var(--bg);
    opacity: 0;
    transition: opacity 0.45s ease;
  }

  .work__embed iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .work:hover .work__embed {
    opacity: 1;
  }

  .work__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 11px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-elevated) 88%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--line);
    color: var(--primary-deep);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  /* 信息区 */
  .work__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px 22px;
    flex: 1;
  }

  .work__meta {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12.5px;
    color: var(--ink-faint);
  }

  .work__venue {
    padding-left: 10px;
    border-left: 1px solid var(--line);
    color: var(--ink-soft);
  }

  .work__title {
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.45;
    letter-spacing: 0.01em;
  }

  .work__title a {
    transition: color 0.3s ease;
  }

  .work__title a:hover {
    color: var(--primary-deep);
  }

  .work__summary {
    font-size: 14px;
    line-height: 1.72;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .work__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .work__actions {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .work__link {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--primary-deep);
    transition:
      color 0.28s ease,
      gap 0.28s ease;
  }

  .work__link span {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .work__link:hover span {
    transform: translateX(3px);
  }

  .work__link--muted {
    color: var(--ink-faint);
    font-weight: 400;
  }

  .work__link--muted:hover {
    color: var(--primary-deep);
  }

  /* 大卡片 */
  .work--featured .work__media {
    aspect-ratio: 16 / 9;
  }

  .work--featured .work__title {
    font-size: 23px;
  }

  @media (max-width: 720px) {
    .work--featured .work__media {
      aspect-ratio: 16 / 10;
    }
    .work--featured .work__title {
      font-size: 19px;
    }
  }
</style>
